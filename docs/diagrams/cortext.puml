@startuml cortext
skinparam monochrome reverse

group cortext {
split
  start
  group Encoding {
    if (vision?) then (yes)
      :EncodeVision;
    elseif (audio?) then (yes)
      :EncodeAudio;
    else (unsupported)
      stop
    endif
  }
  group Amygdala {
    :ComputeEmotions;
  }

  group Hippocampus {
    fork
      group Storage {
        group Centroid {
          if (empty?) then (yes)
            :assign;
          else (no)
            :update;
          endif
          :ComputeDistances;
          :ComputeDrift;
          :ComputeCoherence;
          :ComputeAffect;
        }
        if (boundary?) then (detected)
          :ComputePersistence;
        else (no boundary)
        endif
      }
    fork again
      group Retrieval {
        :QueryMemory;
        :query with current context;
        :RankResults;
        :rank by relevance;
        :ReturnResults;
        :return to context;
      }
    end fork
  }

  group PrefrontalCortex {
    if (full?) then (yes)
      :EvictMemory;
      :evict oldest memory;
      if (long term?) then (yes)
        :Neocortex;
        :long-term memory storage;
      else (no)
      endif
    else (no)
    endif
    :Store;
    :store in working memory;
  }
  detach

split again
  group Consolidation {
    start
    :ConsolidationProcess;
    :cluster & summarize memories;
    detach
  }
end split
}
@enduml
