{
  "schema": "cortext_chat_replay_release_protocol_spec_v1",
  "version": 1,
  "privacy": "public-safe protocol only; no private message text, media bytes, labels, or judge reasons",
  "windows": [
    {
      "name": "early_text_image",
      "skip_messages": 0,
      "max_messages": 1200,
      "media_limit": 16,
      "probe_stride": 25,
      "warmup_events": 200,
      "min_probe_rows_after_benchmark": 30,
      "required_media_modalities": [
        "image"
      ],
      "purpose": "early dense text conversation with image media coverage"
    },
    {
      "name": "video_window",
      "skip_messages": 67300,
      "max_messages": 80,
      "media_limit": 4,
      "probe_stride": 10,
      "warmup_events": 10,
      "min_probe_rows_after_benchmark": 4,
      "required_media_modalities": [
        "video"
      ],
      "purpose": "fixed window that exercises video source blobs"
    },
    {
      "name": "audio_window",
      "skip_messages": 98412,
      "max_messages": 80,
      "media_limit": 4,
      "probe_stride": 10,
      "warmup_events": 10,
      "min_probe_rows_after_benchmark": 4,
      "required_media_modalities": [
        "audio"
      ],
      "purpose": "fixed window that exercises raw speech/audio source blobs"
    }
  ],
  "cortext": {
    "knobs": {
      "focus": 0.5,
      "sensitivity": 0.5,
      "stability": 0.5
    },
    "daily_consolidation": true,
    "deep_consolidation": true,
    "no_eval_specific_cortext_behavior": true
  },
  "baselines": {
    "traditional_chat_rag": {
      "description": "rolling chat history until compaction plus text vector RAG",
      "normal_rag_retrieval": "raw_chat_vector",
      "modality": "text_only",
      "rag_top_k": 5,
      "active_history_token_budget": 8000,
      "media_allowed": false
    },
    "full_history_upper_bound": {
      "description": "text-only full prior chat history upper bound",
      "modality": "text_only",
      "media_allowed": false
    },
    "optional_multimodal_rag": {
      "description": "stronger-than-normal comparator only; not the default RAG baseline",
      "required": false,
      "must_be_marked_separately": true
    }
  },
  "judge": {
    "provider": "local_ollama",
    "model": "gemma4:12b-it-qat",
    "repetitions_min": 3,
    "repetitions_max": 5,
    "packet_aliases": [
      "A",
      "B",
      "C"
    ],
    "blind_packets": true,
    "randomize_packet_order": true,
    "decode_winners_afterward": true,
    "hosted_providers_allowed_for_private_data": false,
    "human_label_min_shared_probes": 30
  },
  "quality": {
    "score_fields": [
      "relevance",
      "sufficiency",
      "noise",
      "temporal_correctness",
      "source_grounding",
      "modality_grounding"
    ],
    "release_composite_fields": [
      "relevance",
      "sufficiency",
      "noise"
    ],
    "release_composite_weights": {
      "relevance": 1.0,
      "sufficiency": 1.0,
      "noise": -0.25
    },
    "bootstrap_samples": 2000,
    "confidence_interval": 0.95
  },
  "ablations": [
    {
      "name": "no_daily_consolidation",
      "daily_consolidation": false,
      "env": {}
    },
    {
      "name": "no_graph_expansion",
      "daily_consolidation": true,
      "env": {
        "CORTEXT_DISABLE_SOURCE_SEED_GRAPH_EXPANSION": "1",
        "CORTEXT_DISABLE_DURABLE_SOURCE_SET_RETRIEVAL": "1",
        "CORTEXT_DISABLE_PRECONSOLIDATED_LABEL_GRAPH": "1"
      }
    },
    {
      "name": "no_media_source_blobs",
      "daily_consolidation": true,
      "env": {
        "CORTEXT_DISABLE_SOURCE_BLOBS": "1"
      }
    },
    {
      "name": "no_stm_ltm_graph_label_handoff",
      "daily_consolidation": true,
      "env": {
        "CORTEXT_DISABLE_STM_LABEL_HANDOFF": "1"
      }
    },
    {
      "name": "no_temporal_retrieval",
      "daily_consolidation": true,
      "env": {
        "CORTEXT_DISABLE_TEMPORAL_RETRIEVAL": "1"
      }
    },
    {
      "name": "no_fact_boosts",
      "daily_consolidation": true,
      "env": {
        "CORTEXT_DISABLE_FACTS": "1"
      }
    },
    {
      "name": "no_temporal_fact_boosts",
      "daily_consolidation": true,
      "env": {
        "CORTEXT_DISABLE_TEMPORAL_RETRIEVAL": "1",
        "CORTEXT_DISABLE_FACTS": "1"
      }
    },
    {
      "name": "no_predictive_bonus",
      "daily_consolidation": true,
      "env": {
        "CORTEXT_DISABLE_PREDICTIVE_RETRIEVAL_BONUS": "1"
      }
    },
    {
      "name": "no_procedural_proactive",
      "daily_consolidation": true,
      "env": {
        "CORTEXT_DISABLE_PROCEDURAL_PROACTIVE_RETRIEVAL": "1"
      }
    },
    {
      "name": "no_metacognitive",
      "daily_consolidation": true,
      "env": {
        "CORTEXT_DISABLE_METACOG_TOT_RECOVERY": "1",
        "CORTEXT_DISABLE_METACOG_UNKNOWN_CAUTION": "1"
      }
    },
    {
      "name": "no_constructive_recall",
      "daily_consolidation": true,
      "env": {
        "CORTEXT_DISABLE_CONSTRUCTIVE_RECALL": "1"
      }
    },
    {
      "name": "no_stm_shadow",
      "daily_consolidation": true,
      "env": {
        "CORTEXT_STM_SHADOW_DISABLE": "1"
      }
    },
    {
      "name": "actr_base_level",
      "daily_consolidation": true,
      "env": {
        "CORTEXT_ENABLE_BASE_LEVEL_AVAILABILITY": "1"
      }
    },
    {
      "name": "actr_recent_inhibition",
      "daily_consolidation": true,
      "env": {
        "CORTEXT_ENABLE_RECENT_RETRIEVAL_INHIBITION": "1"
      }
    },
    {
      "name": "actr_partial_matching",
      "daily_consolidation": true,
      "env": {
        "CORTEXT_ENABLE_PARTIAL_MATCHING_PENALTY": "1"
      }
    },
    {
      "name": "actr_evidence_blending",
      "daily_consolidation": true,
      "env": {
        "CORTEXT_ENABLE_EVIDENCE_BLENDING": "1"
      }
    },
    {
      "name": "actr_all_gates",
      "daily_consolidation": true,
      "env": {
        "CORTEXT_ENABLE_BASE_LEVEL_AVAILABILITY": "1",
        "CORTEXT_ENABLE_RECENT_RETRIEVAL_INHIBITION": "1",
        "CORTEXT_ENABLE_PARTIAL_MATCHING_PENALTY": "1",
        "CORTEXT_ENABLE_EVIDENCE_BLENDING": "1"
      }
    },
    {
      "name": "wm_capacity_10",
      "daily_consolidation": true,
      "env": {
        "CORTEXT_WM_CAPACITY_OVERRIDE": "10"
      }
    },
    {
      "name": "wm_capacity_14",
      "daily_consolidation": true,
      "env": {
        "CORTEXT_WM_CAPACITY_OVERRIDE": "14"
      }
    },
    {
      "name": "wm_capacity_21",
      "daily_consolidation": true,
      "env": {
        "CORTEXT_WM_CAPACITY_OVERRIDE": "21"
      }
    }
  ],
  "cost_metrics": [
    "ingest_throughput_excluding_idle_consolidation",
    "idle_consolidation_wall_time_per_day",
    "retrieval_latency_p50_p95",
    "prompt_tokens_per_turn",
    "disk_growth",
    "memory_use"
  ],
  "fairness_checks": [
    "cortext_media_uses_source_blobs_not_asr_transcripts_or_captions",
    "traditional_chat_rag_is_text_only",
    "source_ids_are_shared_across_modalities",
    "no_future_messages_in_probe_packets",
    "no_hidden_labels_or_benchmark_hints_in_packets",
    "hosted_provider_env_is_stripped_or_rejected"
  ],
  "narrow_claim": "On a frozen private mixed-media conversation replay, production Cortext at default knobs reduced prompt tokens substantially versus traditional chat+RAG while matching or exceeding judged context usefulness on the evaluated probes. Daily consolidation and graph-backed retrieval contributed measurable value under ablation."
}