+/* Ordering used by min_idx: ascending distance, ties broken by HIGHER
+ * index first. This reproduces the original selection-scan exactly: it
+ * compared with `<=` over ascending i, so among equal distances the last
+ * index won each pass. Returns 1 when item a precedes item b. */
+static inline int min_idx_before(const f32 *distances, i32 a, i32 b) {
+  return distances[a] < distances[b] ||
+         (distances[a] == distances[b] && a > b);
+}
+
+static inline void min_idx_sift_down(const f32 *distances, i32 *heap, i32 end,
+                                     i32 root) {
+  for (;;) {
+    i32 l = 2 * root + 1;
+    i32 r = l + 1;
+    i32 m = root;
+    if (l < end && min_idx_before(distances, heap[m], heap[l])) {
+      m = l;
+    }
+    if (r < end && min_idx_before(distances, heap[m], heap[r])) {
+      m = r;
+    }
+    if (m == root) {
+      return;
+    }
+    i32 t = heap[root];
+    heap[root] = heap[m];
+    heap[m] = t;
+    root = m;
+  }
+}
