if(NOT DEFINED ENV{EMSDK})
    message(FATAL_ERROR "Emscripten toolchain requires EMSDK to point to the SDK root")
endif()

set(EMSDK_ROOT $ENV{EMSDK})
set(EMSCRIPTEN_ROOT "${EMSDK_ROOT}/upstream/emscripten")

set(CMAKE_SYSTEM_NAME WASM)
set(CMAKE_SYSTEM_PROCESSOR wasm32)

set(CMAKE_C_COMPILER "${EMSCRIPTEN_ROOT}/emcc")
set(CMAKE_CXX_COMPILER "${EMSCRIPTEN_ROOT}/em++")

set(CMAKE_EXECUTABLE_SUFFIX ".wasm")

set(CMAKE_C_FLAGS_INIT "-Oz -sSTANDALONE_WASM=1 -sALLOW_MEMORY_GROWTH=1")
set(CMAKE_CXX_FLAGS_INIT "-Oz -sSTANDALONE_WASM=1 -sALLOW_MEMORY_GROWTH=1")

set(CMAKE_FIND_ROOT_PATH "${EMSCRIPTEN_ROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

