@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(OBJSTORE_HAS_SHARED @OBJSTORE_BUILD_SHARED@)
set(OBJSTORE_HAS_STATIC @OBJSTORE_BUILD_STATIC@)

if(@OBJSTORE_USE_SYSTEM_SQLITE@)
  find_dependency(SQLite3 REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/objstoreTargets.cmake")

check_required_components(objstore)
