# Custom Bazel target for Cortext - exports ALL C++ API symbols
# This file is copied to BUILD.cortext in litert-lm root by build_litert.sh
#
# Unlike the default litert_lm_shared which filters to only C API symbols,
# this builds a shared library with all symbols exported for C++ consumers.

load("@rules_cc//cc:defs.bzl", "cc_binary")

# C++ shared library that exports all symbols (no -exported_symbol filtering)
# Uses cc_binary with linkshared=True to create a .so/.dylib
#
# Key difference from litert_lm_shared: NO symbol filtering flags
# This exports all C++ symbols including litert::lm::Engine, etc.
cc_binary(
    name = "liblitert_lm_cpp.so",
    deps = [
        "//runtime/engine:litert_lm_lib",
    ],
    linkshared = True,
    # NO exported_symbol filtering - exports everything
    visibility = ["//visibility:public"],
)
