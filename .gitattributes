cmake/hnswlib-prefetch-bounds.patch text eol=lf

# AIST model shards + tokenizer vocab must stay byte-identical (SHA-256 on reassembly).
models/** -text
models/**/*.part-* binary
models/mdbr-leaf-ir/vocab.txt binary
models/manifest.json text eol=lf

# Surname CSV shards (no LFS). Full CSVs are local-only and reassembled from parts.
data/surnames/** -text
data/surnames/**/*.part-* binary
data/surnames/manifest.json text eol=lf
